{
  "ruleset_id": "ctue-default-v1",
  "versao": 1,
  "status_global_thresholds": { "conforme": 85, "atencao": 65, "critico": 40 },
  "alerts": [
    {"id": "conf_baixa", "severidade": "critico", "label": "Conformidade inferior a 50%", "metric": "conformidade_geral", "op": "lt", "value": 50},
    {"id": "desatualizado", "severidade": "critico", "label": "Cadastro não atualizado há mais de 180 dias", "metric": "days_since", "op": "gt_or_never", "value": 180},
    {"id": "seguranca_nc", "severidade": "critico", "label": "Segurança não conforme", "section": "seguranca", "op": "status_in", "value": ["nao_conforme", "critico"]},
    {"id": "acess_critica", "severidade": "alto", "label": "Acessibilidade crítica", "section": "acessibilidade", "op": "status_in", "value": ["nao_conforme", "critico"]},
    {"id": "agua_nc", "severidade": "alto", "label": "Água/Saneamento não conforme", "section": "agua_saneamento_energia", "op": "status_in", "value": ["nao_conforme", "critico"]},
    {"id": "dados_criticos", "severidade": "alto", "label": "Dados críticos ausentes (completude < 30%)", "metric": "completude_geral", "op": "lt", "value": 30}
  ],
  "severity_weights": { "critico": 100, "alto": 60, "medio": 30 },
  "priority_actions": {
    "never":        {"template": "Realizar o cadastro técnico (CTUE) da {escola}", "peso": 120},
    "stale":        {"template": "Atualizar o CTUE da {escola} (desatualizado)", "peso": 90},
    "seguranca":    {"template": "Regularizar a Segurança da {escola} (extintores/brigada/plano)", "peso": 100},
    "acessibilidade": {"template": "Regularizar a Acessibilidade da {escola}", "peso": 80},
    "agua_saneamento_energia": {"template": "Validar Água e Saneamento da {escola}", "peso": 80},
    "conservacao":  {"template": "Revisar a Conservação/necessidade de reforma da {escola}", "peso": 60},
    "completude":   {"template": "Completar o cadastro da {escola} (dados ausentes)", "peso": 70}
  },
  "porte_buckets": [
    {"label": "Pequena (até 200)", "max": 200},
    {"label": "Média (201–500)", "max": 500},
    {"label": "Grande (501+)", "max": null}
  ],
  "maturity": {
    "infra_sections": ["infraestrutura_fisica", "acessibilidade", "agua_saneamento_energia", "seguranca"]
